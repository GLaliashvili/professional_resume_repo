# Notion Integration
# 1. Go to https://www.notion.so/my-integrations and create a new integration
# 2. Copy the "Internal Integration Token" below
VITE_NOTION_API_KEY=secret_...

# 3. Create a blog database in Notion (see schema below)
# 4. Share the database with your integration (... menu > Connections > your integration)
# 5. Copy the database ID from the URL: notion.so/<workspace>/<DATABASE_ID>?v=...
VITE_NOTION_DATABASE_ID=...

# --- Notion Database Schema ---
# Title        | Title          | Article headline
# Slug         | Text           | URL slug, e.g. "simpsonify" → /blog/simpsonify
# Published    | Date           | Publication date
# Status       | Select         | "Draft" or "Published"
# Tags         | Multi-select   | e.g. AI, Product, Coding
# Excerpt      | Text           | Short description shown on blog listing
